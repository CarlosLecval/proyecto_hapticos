.choose-team-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(10, 14, 24);
    overflow: hidden;
}

.bg-tilt {
    position: absolute;
    left: -20%;
    top: -30%;
    width: 140%;
    height: 160%;
    background-color: rgb(16, 20, 34);
    rotate: -8deg;
}

.bg-stripes {
    position: absolute;
    left: -10%;
    top: 10%;
    width: 120%;
    height: 80%;
    background-color: rgba(22, 32, 56, 0.9);
    opacity: 0.65;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.choose-team-content {
    width: 88%;
    max-width: 980px;
    min-width: 320px;
    align-items: center;
    justify-content: center;
    gap: 26px;
}

.header {
    align-items: center;
    gap: 4px;
}

.title {
    -unity-font-definition: url("project://database/Assets/Urban%20Starblues%20Demo.otf?fileID=12800000&guid=84f0212b0f67046fbb1af6e95c238d1d&type=3#Urban Starblues Demo");
    font-size: 54px;
    letter-spacing: 3px;
    color: rgb(236, 249, 255);
}

.subtitle {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.72);
}

.team-grid {
    flex-direction: row;
    width: 100%;
    justify-content: center;
    align-items: flex-end;
    gap: 28px;
    flex-wrap: wrap;
}

.team-slot {
    align-items: center;
    gap: 0;
}

.team-button {
    width: 300px;
    height: 250px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.4);
    opacity: 0.84;
    transition-property: scale, background-color, border-top-color, border-left-color, border-right-color, border-bottom-color, opacity;
    transition-duration: 180ms;
}

.team-button:hover {
    scale: 1.015;
}

.team-button:active {
    scale: 0.985;
}

.team-button.selected {
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.95);
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(0, 0, 0, 0.32);
    border-bottom-color: rgba(0, 0, 0, 0.42);
    scale: 1.02;
    opacity: 1;
}

.team-button-content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.team-name {
    font-size: 34px;
    unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(250, 252, 255);
}

.player-tag {
    margin-top: -24px;
    min-width: 150px;
    height: 54px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 14px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    background-color: rgba(230, 235, 243, 0.96);
    color: rgb(22, 24, 28);
    font-size: 18px;
    unity-text-align: middle-center;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.6);
    border-left-color: rgba(255, 255, 255, 0.4);
    border-right-color: rgba(0, 0, 0, 0.14);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    transition-property: translate, scale, opacity, background-color;
    transition-duration: 220ms;
    opacity: 0.98;
}

.player-tag.animate-swap {
    translate: 0 -10px;
    scale: 1.08;
    opacity: 0.72;
}

.selection-summary {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.82);
    unity-text-align: middle-center;
    transition-property: opacity, translate;
    transition-duration: 220ms;
}

.selection-summary.animate-swap {
    translate: 0 -6px;
    opacity: 0.65;
}

.bottom-area {
    align-items: center;
    gap: 14px;
}

.red-team {
    background-color: rgb(180, 42, 52);
    border-top-color: rgba(255, 220, 220, 0.32);
    border-left-color: rgba(255, 220, 220, 0.18);
    border-right-color: rgba(40, 0, 0, 0.44);
    border-bottom-color: rgba(40, 0, 0, 0.56);
}

.red-team:hover {
    background-color: rgb(205, 54, 65);
}

.blue-team {
    background-color: rgb(18, 120, 220);
    border-top-color: rgba(220, 236, 255, 0.34);
    border-left-color: rgba(220, 236, 255, 0.2);
    border-right-color: rgba(0, 18, 60, 0.44);
    border-bottom-color: rgba(0, 18, 60, 0.56);
}

.blue-team:hover {
    background-color: rgb(36, 144, 245);
}

.menu-button {
    color: rgb(250, 252, 255);
    unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.35);
}

.menu-button.ghost {
    width: 130px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.92);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
}

.continue-button {
    width: 260px;
    height: 62px;
    background-color: rgb(18, 140, 255);
    font-size: 24px;
    border-top-color: rgba(255, 255, 255, 0.2);
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.6);
}

.screen-footer {
    width: 100%;
    align-items: center;
}

.back-button {
    opacity: 0.72;
}
