.game-hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding-top: 26px;
    padding-left: 28px;
    padding-right: 28px;
    align-items: center;
}

.hud-top-row {
    width: 100%;
    max-width: 1180px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.score-card,
.timer-card {
    min-height: 132px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgba(18, 26, 42, 0.82);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.16);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(0, 0, 0, 0.32);
    border-bottom-color: rgba(0, 0, 0, 0.46);
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.32);
}

.player-card {
    width: 270px;
    gap: 2px;
}

.timer-card {
    min-width: 220px;
    align-items: center;
    background-color: rgba(14, 21, 36, 0.92);
}

.player-label,
.timer-caption {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.72);
}

.team-label {
    font-size: 18px;
    unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(236, 249, 255);
}

.score-value,
.timer-value {
    -unity-font-definition: url("project://database/Assets/Urban%20Starblues%20Demo.otf?fileID=12800000&guid=84f0212b0f67046fbb1af6e95c238d1d&type=3#Urban Starblues Demo");
    color: rgb(250, 252, 255);
}

.score-value {
    margin-top: 6px;
    font-size: 54px;
    letter-spacing: 3px;
}

.timer-value {
    margin-top: 2px;
    font-size: 42px;
    letter-spacing: 3px;
    color: rgb(108, 183, 253);
}

.player-red {
    border-top-color: rgba(255, 214, 214, 0.34);
}

.player-red .team-label,
.player-red .score-value {
    color: rgb(255, 110, 110);
}

.player-blue {
    border-top-color: rgba(214, 232, 255, 0.34);
}

.player-blue .team-label,
.player-blue .score-value {
    color: rgb(108, 183, 253);
}
